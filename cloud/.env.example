# PostgreSQL connection from the free Supabase project. Use the pooled connection URL.
SUBGEN_CLOUD_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres

# Supabase Auth. The anon/public key is intentionally public; never put the service-role key here.
SUBGEN_AUTH_PUBLIC_URL=https://PROJECT.supabase.co
SUBGEN_AUTH_PUBLIC_KEY=PUBLIC_ANON_KEY
SUBGEN_AUTH_ISSUER=https://PROJECT.supabase.co/auth/v1
SUBGEN_AUTH_AUDIENCE=authenticated
SUBGEN_AUTH_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Generate once: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SUBGEN_CREDENTIAL_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Cloudflare R2 S3-compatible object storage.
SUBGEN_STORAGE_BACKEND=s3
SUBGEN_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
SUBGEN_STORAGE_REGION=auto
SUBGEN_STORAGE_BUCKET=subgen
SUBGEN_STORAGE_ACCESS_KEY=R2_ACCESS_KEY
SUBGEN_STORAGE_SECRET_KEY=R2_SECRET_KEY

SUBGEN_PUBLIC_BASE_URL=https://YOUR_CLOUD_RUN_URL
SUBGEN_CORS_ORIGINS=https://YOUR_VERCEL_PROJECT.vercel.app
SUBGEN_MAX_UPLOAD_BYTES=536870912
SUBGEN_MAX_ACTIVE_JOBS=1
SUBGEN_MAX_ACTIVE_JOBS_GLOBAL=1
SUBGEN_MAX_JOBS_PER_USER_DAY=1
SUBGEN_MAX_JOBS_GLOBAL_DAY=1
SUBGEN_MAX_JOBS_PER_USER_MONTH=4
SUBGEN_MAX_JOBS_GLOBAL_MONTH=6
SUBGEN_MAX_VIDEO_MINUTES=20
SUBGEN_RETENTION_DAYS=2
SUBGEN_PROCESSING_ENABLED=false
SUBGEN_WORKER_DISPATCH_MODE=disabled
SUBGEN_ENABLE_PIPELINE_WORKER=false
SUBGEN_ENABLE_GPU_WORKER=false

# Required only after connecting a Google Cloud Run Job dispatcher.
SUBGEN_GCP_PROJECT_ID=YOUR_DEDICATED_PROJECT_ID
SUBGEN_GCP_REGION=europe-west1
SUBGEN_GCP_WORKER_JOB=subgen-worker
