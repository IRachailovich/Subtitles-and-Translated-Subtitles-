{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SubGen",
  "version": "0.4.2",
  "identifier": "com.subgen.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SubGen Studio",
        "url": "index.html",
        "width": 1440,
        "height": 920,
        "minWidth": 1060,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["desktop-local-backend"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": [
      "resources/backend/**/*",
      "resources/ffmpeg/**/*",
      "resources/licenses/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
